# Copy to .env and fill in. Never commit .env.

# Required for scoring, tailoring and cover letters (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Claude model and effort (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Server-side refusal fallbacks: "default" (on) or "off"
CLAUDE_FALLBACKS=default

# Storage locations
DATABASE_PATH=data/jobs.db
PROFILE_DIR=profile
PREFERENCES_FILE=config/preferences.yaml
OUTPUT_DIR=output

# Set a password before exposing the app to the internet (HTTP Basic, any username)
APP_PASSWORD=

# Fetch automatically every N hours while the web app runs (0 = off)
SCHEDULE_FETCH_HOURS=0

# Optional comma-separated proxies for JobSpy (user:pass@host:port,...)
JOBSPY_PROXIES=
